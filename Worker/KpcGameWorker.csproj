<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion><Version>0.7.2</Version><DefineConstants>$(DefineConstants);GAME_WORKER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Core/*.cs" Exclude="../Core/LauncherUpdater.cs;../Core/RelayCommand.cs;../Core/DesktopUi.cs" />
    <EmbeddedResource Include="../Assets/tester-signing-public.pem" LogicalName="KpcLauncher.tester-signing-public.pem" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
