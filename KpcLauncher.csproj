<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KpcLauncher</AssemblyName>
    <RootNamespace>KpcLauncher</RootNamespace>
    <StartupObject>KpcLauncher.Program</StartupObject>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;bin\**;obj\**</DefaultItemExcludes>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\launcher.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.6.2</Version>
    <Product>KPC Launcher</Product>
    <Description>Steam downloads and server-authorized community testing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\tester-signing-public.pem" LogicalName="KpcLauncher.tester-signing-public.pem" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\launcher-logo.png" />
    <Resource Include="Assets\launcher.ico" />
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
