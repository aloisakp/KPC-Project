<Window x:Class="KpcLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KPC Launcher" Height="640" Width="960" MinHeight="560" MinWidth="820"
        Background="{StaticResource Bg}"
        Icon="/KpcLauncher;component/Assets/launcher.ico"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource Chrome}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,16,0"
                                VerticalAlignment="Center">
                        <Image Source="/KpcLauncher;component/Assets/launcher-logo.png"
                               Width="22" Height="22" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="KPC" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Semibold" FontSize="13"/>
                        <TextBlock Text="Launcher" Margin="5,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Faint}" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton Content="Home" Style="{StaticResource NavTab}" GroupName="Nav"
                                     IsChecked="{Binding IsHome, Mode=TwoWay}"/>
                        <RadioButton Content="Settings" Style="{StaticResource NavTab}" GroupName="Nav"
                                     IsChecked="{Binding IsSettings, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <TextBlock Text="Steam" VerticalAlignment="Center"
                                   Foreground="{StaticResource Faint}" FontSize="12"/>
                        <TextBlock Text="{Binding SteamStatus}" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimise">
                            <Path Data="M 0,0 H 10"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="Maximise">
                            <Path Data="M 0,0 H 9 V 9 H 0 Z"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1" Fill="Transparent"/>
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="OnClose" ToolTip="Close">
                            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                  StrokeThickness="1.3"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Shared decorative background, below the interactive content. -->
            <Grid Grid.Row="1" ClipToBounds="True" IsHitTestVisible="False">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#18243A" Offset="0"/>
                        <GradientStop Color="#101722" Offset="0.55"/>
                        <GradientStop Color="#0C0E13" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Right">
                    <Grid Width="560" Height="500">
                        <Ellipse Width="680" Height="680" HorizontalAlignment="Right"
                                 VerticalAlignment="Center" Margin="0,0,-190,0" Opacity="0.35">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#47618B" Offset="0"/>
                                    <GradientStop Color="#0047618B" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Image Source="/KpcLauncher;component/Assets/launcher-logo.png"
                               Width="560" Height="560" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,-65,0" Opacity="0.065"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Viewbox>
            </Grid>

            <!-- Home -->
            <Grid Grid.Row="1" Visibility="{Binding IsHome, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" Margin="46,0">
                    <TextBlock Text="KPC LAUNCHER" Style="{StaticResource H1}"/>
                    <TextBlock Text="Preservation mode" Style="{StaticResource Sub}"
                               FontSize="14" Margin="0,6,0,0"/>

                    <Border Background="#141926" CornerRadius="7" Margin="0,24,0,0" Padding="18,15"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" MaxWidth="720"
                            HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="UNDER CONSTRUCTION" Style="{StaticResource Label}"
                                       Foreground="{StaticResource Warn}"/>
                            <TextBlock Text="Download preservation only. Additional launcher features are not available yet."
                                       FontSize="15" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Sub}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Facts}" Margin="0,20,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#141926" CornerRadius="5" Margin="0,0,10,10"
                                        Padding="14,9" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        MaxWidth="470">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Label}"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding Value}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- Settings -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsSettings, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="46,32,46,32" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Storage location" Style="{StaticResource H2}"/>
                    <TextBlock Text="The two required file sets are stored separately and are never combined or modified."
                               Style="{StaticResource Sub}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                    <Grid Margin="0,0,0,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding StorageRoot, Mode=OneWay}"/>
                        <Button Grid.Column="1" Content="Browse" Margin="8,0,0,0"
                                Command="{Binding BrowseCommand}"/>
                        <Button Grid.Column="2" Content="Open" Margin="8,0,0,0"
                                Style="{StaticResource Ghost}" Command="{Binding OpenFolderCommand}"/>
                    </Grid>

                    <TextBlock Text="Launcher updates" Style="{StaticResource H2}"/>
                    <TextBlock Text="Updates are checked automatically when the launcher starts. Installing an update always requires your confirmation."
                               Style="{StaticResource Sub}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                    <Border Background="#141926" CornerRadius="5" Padding="14" Margin="0,0,0,10"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="VERSION" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding CurrentVersion}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="STATUS" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding UpdateStatus}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button Content="{Binding UpdateButtonText}" Style="{StaticResource Primary}"
                            Command="{Binding CheckUpdatesCommand}" HorizontalAlignment="Left"
                            Margin="0,0,0,26"/>

                    <TextBlock Text="Steam" Style="{StaticResource H2}"/>
                    <TextBlock Text="Authorize your Steam account in your browser. Steam itself downloads the files; its signed-in account must match the account you authorize here. The launcher never asks for your Steam password or a QR code."
                               Style="{StaticResource Sub}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                    <Border Background="#141926" CornerRadius="5" Padding="14" Margin="0,0,0,10"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="STATUS" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding SteamStatus}"/>
                            <TextBlock Text="AUTHORIZED ACCOUNT" Style="{StaticResource Label}" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding AuthorizedAccount}"/>
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,0,0,26">
                        <Button Content="Authorize Steam" Command="{Binding AuthorizeCommand}" Style="{StaticResource Primary}"/>
                        <Button Content="Disconnect account" Command="{Binding ForgetAccountCommand}"
                                Style="{StaticResource Ghost}" Margin="8,0,0,0"/>
                        <Button Content="Open Steam folder" Command="{Binding OpenSteamFolderCommand}"
                                Style="{StaticResource Ghost}" Margin="8,0,0,0"/>
                    </WrapPanel>

                    <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,26"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open download folder" Command="{Binding OpenFolderCommand}"
                                Style="{StaticResource Ghost}"/>
                        <Button Content="Open log file" Command="{Binding OpenLogCommand}"
                                Style="{StaticResource Ghost}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Settings save as you change them." Style="{StaticResource Sub}"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Action bar -->
            <Border Grid.Row="2" Background="{StaticResource Chrome}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,1,0,0" Padding="46,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="{Binding StepName}" FontFamily="Segoe UI Semibold" FontSize="14"/>
                        <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Sub}" Margin="0,3,0,0"
                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Margin="0,9,0,0" Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Log" Style="{StaticResource Ghost}"
                                Command="{Binding ToggleLogCommand}" Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="Cancel" Style="{StaticResource Ghost}"
                                ToolTip="Cancels launcher work. Steam may continue a transfer already requested."
                                Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{Binding DownloadButtonText}" Style="{StaticResource Primary}"
                                Command="{Binding DownloadCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Log -->
            <Border Grid.Row="3" Background="#080A0E" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,1,0,0" Height="190"
                    Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Padding="46,10">
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"
                                           FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
