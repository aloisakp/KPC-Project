<Project Sdk="Microsoft.NET.Sdk">
  <!-- The game worker's own sources, trusting a key the Linux export check generates for its stand-in packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion><Version>0.8.0</Version><AssemblyName>KpcGameWorker</AssemblyName>
    <DefineConstants>$(DefineConstants);GAME_WORKER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/*.cs" Exclude="../../Core/LauncherUpdater.cs;../../Core/RelayCommand.cs;../../Core/DesktopUi.cs" />
    <Compile Include="../../Worker/Program.cs" />
    <EmbeddedResource Include="$(TestSigningKey)" LogicalName="KpcLauncher.tester-signing-public.pem" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <Target Name="RequireTestSigningKey" BeforeTargets="Build" Condition="'$(TestSigningKey)' == ''">
    <Error Text="Pass -p:TestSigningKey=path/to/test-public.pem" />
  </Target>
</Project>
